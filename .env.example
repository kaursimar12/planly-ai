PORT=3000

# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:../data/planly.db"

OPENAI_API_KEY=
# Answers every chat message (needs web_search + structured outputs)
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local LanceDB vector store directory
LANCEDB_DIR=data/lancedb

# Set to true behind HTTPS so session cookies are marked Secure
COOKIE_SECURE=false
