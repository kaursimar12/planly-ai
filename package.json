{
  "name": "planly-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Personalized AI planner for weekends, social activities and free time.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "test": "node --test",
    "test-cases": "node scripts/build-test-cases.js"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.40.0",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "@prisma/client": "^6.19.3",
    "apache-arrow": "^18.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "openai": "^7.30.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
